#!/usr/bin/env bash
# Refuse commits that contain state files, private keys or tokens.
set -euo pipefail
fail=0
files=$(git diff --cached --name-only --diff-filter=ACM)
for f in $files; do
  case "$f" in
    *.tfstate|*.tfstate.*|*.tfplan|*/.terraform/*|*.pem|*.key|*.p12|.env|*/id_rsa|*/id_ed25519|*/id_ecdsa)
      echo "pre-commit: refusing to commit $f (state/key/secret file)"; fail=1 ;;
  esac
done
# The hook's own folder is skipped: its patterns would otherwise match themselves.
if git diff --cached -U0 --diff-filter=ACM -- . ':(exclude)scripts/git-hooks' | grep -nE \
  -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
  -e 'PVEAPIToken[=]' \
  -e '[A-Za-z0-9._-]+@[A-Za-z0-9.-]+![A-Za-z0-9._-]+=[0-9a-f]{8}-[0-9a-f]{4}-' \
  -e 'glpat-[A-Za-z0-9_-]{20,}' \
  -e 'ansible_(ssh_)?(become_)?pass(word)?:[[:space:]]*[^{[:space:]]' >/dev/null; then
  echo "pre-commit: staged changes look like they contain a secret (private key, Proxmox/GitLab token or password)."
  echo "            Move it to the keychain and reference it via homelab.yaml secrets."
  fail=1
fi
exit $fail
