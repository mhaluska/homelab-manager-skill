# --- OpenTofu (state lives outside the repo; never commit state or plans) ---
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
.terraform.tfstate.lock.info
crash.log
crash.*.log
# keep: .terraform.lock.hcl

# --- Packer ---
packer_cache/
**/output-*/
*.secret.pkrvars.hcl

# --- Ansible ---
*.retry
ansible/collections/
.vault_pass*
**/vault-password*

# --- Secrets: never in Git ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_*
!id_*.pub
*.secret.*

# --- Discovery: raw scan output stays local; JSON summaries are committed ---
discovery/nmap/

# --- Zabbix: a plan is applied once and deleted; it may be stale by the next session ---
zabbix/plan.json

# --- OS / editors ---
.DS_Store
.vscode/
.idea/

# Packer build manifests are summarised into docs/templates.md
packer/**/manifest.json
packer/**/site.pkrvars.hcl
