# Managed by Ansible (homelab-manager zabbix_agent2 role): settings from homelab.yaml (zabbix:).
# These keys are commented out in zabbix_agent2.conf (a key set twice stops the agent). Edit homelab.yaml or the
# role's variables, not this file. A key left out here (Server or ServerActive by zabbix.agent.mode) is unset.
{% for k, v in zbx_settings.items() if v | string | length %}
{{ k }}={{ v }}
{% endfor %}
{% for line in zabbix_agent_extra %}
{{ line }}
{% endfor %}
