{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)"
    ],
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*key*)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.kube/config)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/.vault_pass*)"
    ],
    "ask": [
      "Bash(tofu apply:*)",
      "Bash(tofu -chdir=*apply*)",
      "Bash(packer build:*)"
    ]
  }
}
